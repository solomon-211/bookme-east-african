-      // Cancelling is a status change, so history is kept for refunds.
-      allow delete: if false;
+      function keepsTripAndPrice() {
+        return request.resource.data.totalAmount == resource.data.totalAmount
+            && request.resource.data.tripId == resource.data.tripId;
+      }
+
+      // Change date (Tickets & Trips): a paid booking moves to another
+      // departure at the same price or cheaper, adding one history entry.
+      function changingDeparture() {
+        return resource.data.status == 'paid'
+            && request.resource.data.status == 'paid'
+            && onlyChanges(['tripId', 'seatNumber', 'totalAmount',
+                            'changeHistory', 'updatedAt'])
+            && request.resource.data.totalAmount is int
+            && request.resource.data.totalAmount > 0
+            && request.resource.data.totalAmount <= resource.data.totalAmount
+            && request.resource.data.changeHistory.size()
+                 == resource.data.get('changeHistory', []).size() + 1;
+      }
+
+      // Cancelling (Tickets & Trips) records the refund; it can never be
+      // more than was paid.
+      function validRefund() {
+        return !('refundAmount' in request.resource.data)
+            || (request.resource.data.refundAmount is int
+                && request.resource.data.refundAmount >= 0
+                && request.resource.data.refundAmount
+                     <= request.resource.data.totalAmount);
+      }
+
+      // Remove from history (Tickets & Trips): only cancelled or expired
+      // bookings, or paid ones whose trip has already arrived. Upcoming
+      // paid trips must be cancelled first, so refunds keep their record.
+      allow delete: if signedIn()
+                    && resource.data.userId == request.auth.uid
+                    && (resource.data.status in ['cancelled', 'expired']
+                        || (resource.data.status == 'paid'
+                            && tripHasArrived(resource.data.tripId)));
+
+      function tripHasArrived(tripId) {
+        let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
+        return trip.get('arrival', trip.get('arrivalTime', request.time))
+                 < request.time;
+      }
     }
 
